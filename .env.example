# Cloudflare Turnstile site key for the contact form (public; safe in the browser).
# Never put the secret key here: it belongs only in pmuforms-api's TURNSTILE_SECRET_KEY.
# Cloudflare test site key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# optional: API base URL (defaults to https://admin.pmuforms.com)
VITE_API_URL=

# optional analytics (leave both empty to disable). Use ONE of these:
# Google Tag Manager container ID; GA4 and other tags are then set up inside GTM.
VITE_GTM_ID=
# or Google Analytics 4 directly (ignored when VITE_GTM_ID is set).
VITE_GA_MEASUREMENT_ID=
